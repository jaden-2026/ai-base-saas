# SkillPort AI V1.2 / 1.2.0 environment template.
# Never commit real production credentials. The values below are local-development examples only.
DATABASE_URL=postgresql://postgres:admin@127.0.0.1:5432/skillport_ai
# Used only by `pnpm db:setup`; remove from the long-running application environment afterward.
POSTGRES_ADMIN_URL=postgresql://postgres:admin@127.0.0.1:5432/postgres
REDIS_URL=redis://127.0.0.1:6379
REDIS_PREFIX=skillport:
# Internal Fastify port. Production should expose only HTTPS 443 through a reverse proxy.
PORT=3001
# Browser-facing Origin, without a trailing path. Production: https://xxxx
APP_URL=http://localhost:5173
# 32+ character encryption secret; replace and back up securely outside local development.
APP_SECRET=skillport-local-development-secret-change-me
# Local-development super administrator seeded by `pnpm db:setup`.
# Public demo credentials only. Replace them before any shared or production deployment.
SEED_OWNER_EMAIL=admin@skillport.local
SEED_OWNER_PASSWORD=SkillPort@123456
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# WeChat Pay API v3 Native fallback. Priority: tenant override > platform default > these values.
WECHAT_PAY_APP_ID=
WECHAT_PAY_MERCHANT_ID=
WECHAT_PAY_MERCHANT_SERIAL_NO=
# PEM values may use literal \n line breaks in this file.
WECHAT_PAY_PRIVATE_KEY=
# Exactly 32 bytes.
WECHAT_PAY_API_V3_KEY=
# Recommended WeChat Pay public key mode: PUB_KEY_ID_...
WECHAT_PAY_PUBLIC_KEY_ID=
WECHAT_PAY_PUBLIC_KEY=
# Disaster-recovery fallback. Super admins normally maintain the platform default callback in System Settings.
# Production value: https://XXXX
WECHAT_PAY_NOTIFY_URL=